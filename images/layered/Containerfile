# syntax=docker/dockerfile:1

ARG FRAPPE_BUILD_IMAGE
ARG FRAPPE_BASE_IMAGE

FROM ${FRAPPE_BUILD_IMAGE} AS builder

# NDF adds post-Bench evidence capture without changing upstream Bench/runtime layers.
COPY --chown=frappe:0 images/ndf/scripts/capture_build_inventory.py /opt/ndf/capture_build_inventory.py
COPY --chown=frappe:0 images/ndf/scripts/capture_source_provenance.py /opt/ndf/capture_source_provenance.py
COPY --chown=frappe:0 images/ndf/scripts/source_tree_fingerprint.py /opt/ndf/source_tree_fingerprint.py
COPY --chown=frappe:0 images/ndf/scripts/verify_source_tree.py /opt/ndf/verify_source_tree.py

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

USER frappe

# Apply group permissions after app installation and cleanup, before the runtime COPY.
RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=0 \
  --mount=type=secret,id=build_lock,target=/opt/ndf/build-lock-v2.json,uid=1000,gid=0 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  /home/frappe/frappe-bench/env/bin/python /opt/ndf/capture_build_inventory.py \
    --bench /home/frappe/frappe-bench \
    --lock /opt/ndf/build-lock-v2.json \
    --output /home/frappe/frappe-bench/build-evidence/build-inventory.json && \
  /home/frappe/frappe-bench/env/bin/python /opt/ndf/capture_source_provenance.py \
    --bench /home/frappe/frappe-bench \
    --lock /opt/ndf/build-lock-v2.json \
    --output /home/frappe/frappe-bench/build-evidence/source-provenance.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr && \
  /home/frappe/frappe-bench/env/bin/python /opt/ndf/verify_source_tree.py \
    --bench /home/frappe/frappe-bench \
    --provenance /home/frappe/frappe-bench/build-evidence/source-provenance.json \
    --stage post_cleanup \
    --output /home/frappe/frappe-bench/build-evidence/source-tree-verification-post-cleanup.json && \
  chmod -R g=u /home/frappe/frappe-bench

FROM ${FRAPPE_BASE_IMAGE} AS backend

USER frappe

COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench
COPY --from=builder --chown=frappe:0 /opt/ndf/source_tree_fingerprint.py /opt/ndf/source_tree_fingerprint.py
COPY --from=builder --chown=frappe:0 /opt/ndf/verify_source_tree.py /opt/ndf/verify_source_tree.py

WORKDIR /home/frappe/frappe-bench

# Keep the COPY destination group-writable and move assets to image-layer storage
RUN chmod g=u /home/frappe/frappe-bench && \
  cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
