{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/application-manifest-v2.schema.json",
  "title": "NDF Frappe Composition Manifest v2",
  "description": "Composition root selecting reusable Marketplace App Descriptors. Product-specific inclusion and source-ref overrides remain here.",
  "type": "object",
  "required": ["manifest_version", "id", "name", "framework", "profile", "resolution", "validation"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"const": "2.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "framework": {
      "type": "object",
      "required": ["name", "version", "release_channel", "target_ref"],
      "properties": {
        "name": {"const": "frappe"},
        "version": {"type": "string", "minLength": 1},
        "release_channel": {"enum": ["stable", "development"]},
        "target_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": ["type", "required", "install_by_default"],
      "properties": {
        "type": {"enum": ["base", "capability", "product"]},
        "required": {"type": "boolean"},
        "install_by_default": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "resolution": {
      "type": "object",
      "properties": {
        "strategy": {"enum": ["locked", "latest-compatible"]},
        "require_immutable_commit": {"type": "boolean"},
        "fail_on_unverified_compatibility": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest"],
        "properties": {
          "manifest": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest"],
        "properties": {
          "manifest": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "install_by_default": {"type": "boolean"},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["descriptor", "required"],
            "properties": {
              "descriptor": {
                "type": "string",
                "minLength": 1,
                "description": "Normalized repository-relative POSIX path to a Marketplace App Descriptor JSON file."
              },
              "required": {"type": "boolean"},
              "target_ref": {"type": "string", "minLength": 1},
              "ref": {"type": ["string", "null"], "description": "Temporary migration field; not an authoritative source pin."},
              "install_order": {"type": "integer", "minimum": 0},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["name", "repository", "target_ref", "required", "install_order", "dependencies"],
            "description": "Legacy v1 embedded application entry retained only for transition/read compatibility.",
            "properties": {
              "name": {"type": "string"},
              "repository": {"type": "string", "format": "uri"},
              "target_ref": {"type": "string"},
              "ref": {"type": ["string", "null"]},
              "required": {"type": "boolean"},
              "install_order": {"type": "integer", "minimum": 0},
              "dependencies": {"type": "array", "items": {"type": "string"}},
              "compatibility_status": {"type": "string"},
              "notes": {"type": "string"}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "services": {"type": "array", "items": {"type": "object"}},
    "validation": {
      "type": "object",
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "deployment": {"type": "object"}
  },
  "additionalProperties": true
}
