{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/application-manifest-v2.schema.json",
  "title": "NDF Frappe Composition Manifest v2",
  "description": "Composition root selecting reusable Marketplace App Descriptors. Product-specific inclusion and source-ref overrides remain here.",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "framework",
    "profile",
    "resolution",
    "target_runtime",
    "validation"
  ],
  "$defs": {
    "target_image_identity": {
      "type": "object",
      "required": ["reference", "manifest_digest", "platform"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[a-fA-F0-9]{64}$"
        },
        "index_digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "platform": {
          "type": "string",
          "pattern": "^linux/(amd64|arm64)$"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "manifest_version": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "framework": {
      "type": "object",
      "required": ["name", "version", "release_channel", "target_ref"],
      "properties": {
        "name": { "const": "frappe" },
        "version": { "type": "string", "minLength": 1 },
        "release_channel": { "enum": ["stable", "development"] },
        "target_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "target_runtime": {
      "type": "object",
      "required": ["frappe", "python"],
      "properties": {
        "frappe": { "type": "string", "minLength": 1 },
        "erpnext": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "platform": {
          "type": "object",
          "required": ["os", "architecture"],
          "properties": {
            "os": { "const": "linux" },
            "architecture": { "enum": ["amd64", "arm64"] }
          },
          "additionalProperties": false,
          "description": "OCI target platform. This is image metadata, not the CI runner platform."
        },
        "images": {
          "type": "object",
          "required": ["builder", "runtime"],
          "properties": {
            "builder": { "$ref": "#/$defs/target_image_identity" },
            "runtime": { "$ref": "#/$defs/target_image_identity" }
          },
          "additionalProperties": false,
          "description": "Digest-bound builder and final runtime image identities for this target platform."
        },
        "os": {
          "type": "object",
          "required": ["distribution_family", "package_manager"],
          "properties": {
            "distribution_family": { "enum": ["debian", "rpm", "alpine"] },
            "id": { "type": "string", "minLength": 1 },
            "pretty_name": { "type": "string", "minLength": 1 },
            "version_id": { "type": "string", "minLength": 1 },
            "codename": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 },
            "package_manager": {
              "enum": ["apt", "dpkg", "dnf", "yum", "rpm", "apk"]
            },
            "package_manager_version": { "type": "string", "minLength": 1 },
            "package_database": { "type": "string", "minLength": 1 },
            "package_database_version": { "type": "string", "minLength": 1 },
            "release": { "type": "string" },
            "libc": {
              "type": "object",
              "required": ["implementation", "version"],
              "properties": {
                "implementation": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "python_implementation": { "type": "string", "minLength": 1 },
        "python_cache_tag": { "type": "string", "minLength": 1 },
        "python_soabi": { "type": "string", "minLength": 1 },
        "python_platform": { "type": "string", "minLength": 1 },
        "python_executable": { "type": "string", "minLength": 1 },
        "python_build": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 },
        "node_platform": { "type": "string", "minLength": 1 },
        "node_architecture": { "type": "string", "minLength": 1 },
        "node_abi": { "type": "string", "minLength": 1 },
        "node_api": { "type": "string", "minLength": 1 },
        "node_executable": { "type": "string", "minLength": 1 },
        "package_versions": {
          "type": "object",
          "description": "Exact package versions supplied by the target image/package-manager resolution context.",
          "additionalProperties": {
            "type": "object",
            "required": ["version", "source", "resolver"],
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "format": "uri", "minLength": 1 },
              "resolver": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "selected_optional_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Explicit optional dependency selections, using ecosystem:identity."
    },
    "profile": {
      "type": "object",
      "required": ["type", "required", "install_by_default"],
      "properties": {
        "type": { "enum": ["base", "capability", "product"] },
        "required": { "type": "boolean" },
        "install_by_default": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "resolution": {
      "type": "object",
      "properties": {
        "strategy": { "enum": ["locked", "latest-compatible"] },
        "require_immutable_commit": { "type": "boolean" },
        "fail_on_unverified_compatibility": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest"],
        "properties": {
          "manifest": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest"],
        "properties": {
          "manifest": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "install_by_default": { "type": "boolean" },
          "selected": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "required": { "const": false } },
              "required": ["required"]
            },
            "then": { "required": ["selected"] }
          }
        ],
        "additionalProperties": true
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["descriptor", "required"],
            "properties": {
              "descriptor": {
                "type": "string",
                "minLength": 1,
                "description": "Normalized repository-relative POSIX path to a Marketplace App Descriptor JSON file."
              },
              "required": { "type": "boolean" },
              "selected": { "type": "boolean" },
              "target_ref": { "type": "string", "minLength": 1 },
              "ref": {
                "type": ["string", "null"],
                "description": "Temporary migration field; not an authoritative source pin."
              },
              "install_order": { "type": "integer", "minimum": 0 },
              "notes": { "type": "string" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "required": { "const": false } },
                  "required": ["required"]
                },
                "then": { "required": ["selected"] }
              }
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "repository",
              "target_ref",
              "required",
              "install_order",
              "dependencies"
            ],
            "description": "Legacy v1 embedded application entry retained only for transition/read compatibility.",
            "properties": {
              "name": { "type": "string" },
              "repository": { "type": "string", "format": "uri" },
              "target_ref": { "type": "string" },
              "ref": { "type": ["string", "null"] },
              "required": { "type": "boolean" },
              "install_order": { "type": "integer", "minimum": 0 },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" }
              },
              "compatibility_status": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["descriptor", "required"],
        "properties": {
          "descriptor": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "selected": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "required": { "const": false } },
              "required": ["required"]
            },
            "then": { "required": ["selected"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "external_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["descriptor", "required"],
        "properties": {
          "descriptor": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "selected": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "required": { "const": false } },
              "required": ["required"]
            },
            "then": { "required": ["selected"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "required_checks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "deployment": { "type": "object" }
  },
  "additionalProperties": true
}
