{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ndf:schemas:source-provenance-verification-v1",
  "title": "NDF Independent Source Provenance Verification",
  "description": "Independent verification of lock-v2, Git identity and source state against pre-cleanup source provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "verifier",
    "lock",
    "source_provenance_sha256",
    "repositories",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithm": {
      "const": "ndf-source-provenance-verification-v1"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "verify_source_provenance.py"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_provenance_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "status": {
      "const": "passed"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "trackedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches_head",
        "installation_modified_paths",
        "installation_diff_sha256"
      ],
      "properties": {
        "matches_head": {
          "type": "boolean"
        },
        "installation_modified_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "installation_diff_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "generatedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "untracked_paths",
        "ignored_paths"
      ],
      "properties": {
        "origin": {
          "const": "post_clone_bench_init"
        },
        "untracked_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ignored_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sourceTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "entry_count",
        "file_count",
        "directory_count",
        "symlink_count"
      ],
      "properties": {
        "algorithm": {
          "const": "ndf-source-tree-sha256-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "directory_count": {
          "type": "integer",
          "minimum": 0
        },
        "symlink_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "submodule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "materialized",
            "expected_commit",
            "status"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "materialized": {
              "const": false
            },
            "expected_commit": {
              "$ref": "#/$defs/gitObject"
            },
            "status": {
              "const": "metadata_only"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "materialized",
            "expected_commit",
            "actual_commit",
            "head_tree",
            "tracked_content",
            "generated_content",
            "source_tree",
            "submodules",
            "status"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "materialized": {
              "const": true
            },
            "expected_commit": {
              "$ref": "#/$defs/gitObject"
            },
            "actual_commit": {
              "$ref": "#/$defs/gitObject"
            },
            "head_tree": {
              "$ref": "#/$defs/gitObject"
            },
            "tracked_content": {
              "$ref": "#/$defs/trackedContent"
            },
            "generated_content": {
              "$ref": "#/$defs/generatedContent"
            },
            "source_tree": {
              "$ref": "#/$defs/sourceTree"
            },
            "submodules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/submodule"
              }
            },
            "status": {
              "const": "verified"
            }
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "requested_ref",
        "resolver_commit",
        "actual_commit",
        "head_tree",
        "tracked_content",
        "generated_content",
        "source_tree",
        "submodules",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/@:]+/.+$"
        },
        "requested_ref": {
          "type": "string",
          "minLength": 1
        },
        "resolver_commit": {
          "type": "string"
        },
        "actual_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "head_tree": {
          "$ref": "#/$defs/gitObject"
        },
        "tracked_content": {
          "$ref": "#/$defs/trackedContent"
        },
        "generated_content": {
          "$ref": "#/$defs/generatedContent"
        },
        "source_tree": {
          "$ref": "#/$defs/sourceTree"
        },
        "submodules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/submodule"
          }
        },
        "status": {
          "const": "verified"
        }
      }
    }
  }
}
