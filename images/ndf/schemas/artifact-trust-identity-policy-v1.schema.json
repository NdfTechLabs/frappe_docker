{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/artifact-trust-identity-policy-v1.schema.json",
  "title": "NDF Artifact Trust Signer Identity Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "status",
    "issuer",
    "verification",
    "identities",
    "required_claims",
    "reusable_workflow_claims",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "const": "ndf-artifact-trust-identity-policy-v1"
    },
    "status": {
      "enum": ["provisional_until_live_certificate_observation", "confirmed"]
    },
    "issuer": {
      "const": "https://token.actions.githubusercontent.com"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_identity_mode",
        "certificate_identity_regex_allowed",
        "oidc_issuer_mode",
        "oidc_issuer_regex_allowed",
        "required_ref",
        "required_event_name",
        "required_repository",
        "require_rekor_inclusion_proof",
        "fail_closed_on_missing_claims"
      ],
      "properties": {
        "certificate_identity_mode": {
          "const": "exact"
        },
        "certificate_identity_regex_allowed": {
          "const": false
        },
        "oidc_issuer_mode": {
          "const": "exact"
        },
        "oidc_issuer_regex_allowed": {
          "const": false
        },
        "required_ref": {
          "const": "refs/heads/main"
        },
        "required_event_name": {
          "const": "workflow_dispatch"
        },
        "required_repository": {
          "const": "NdfTechLabs/frappe_docker"
        },
        "require_rekor_inclusion_proof": {
          "const": true
        },
        "fail_closed_on_missing_claims": {
          "const": true
        }
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "required_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "iss",
          "repository",
          "ref",
          "event_name",
          "workflow_ref",
          "run_id",
          "run_attempt"
        ]
      }
    },
    "reusable_workflow_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_when_configured",
        "must_match_exactly",
        "caller_workflow_must_match_identity_entry",
        "called_workflow_must_match_identity_entry"
      ],
      "properties": {
        "required_when_configured": {
          "const": ["job_workflow_ref", "job_workflow_sha"]
        },
        "must_match_exactly": {
          "const": true
        },
        "caller_workflow_must_match_identity_entry": {
          "const": true
        },
        "called_workflow_must_match_identity_entry": {
          "const": true
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_kinds",
        "certificate_identity",
        "workflow_ref",
        "reusable_workflow_ref",
        "runtime_observation_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["product_image", "candidate_image", "pdd"]
          }
        },
        "certificate_identity": {
          "type": "string",
          "pattern": "^https://github\\.com/NdfTechLabs/frappe_docker/\\.github/workflows/[a-z0-9._-]+\\.yml@refs/heads/main$"
        },
        "workflow_ref": {
          "type": "string",
          "pattern": "^NdfTechLabs/frappe_docker/\\.github/workflows/[a-z0-9._-]+\\.yml@refs/heads/main$"
        },
        "reusable_workflow_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^NdfTechLabs/frappe_docker/\\.github/workflows/[a-z0-9._-]+\\.yml@refs/heads/main$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_observation_required": {
          "const": true
        }
      }
    }
  }
}
