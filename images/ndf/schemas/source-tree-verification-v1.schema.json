{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ndf:schemas:source-tree-verification-v1",
  "title": "NDF Source Tree Stage Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "stage",
    "source_provenance_sha256",
    "lock",
    "repositories",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithm": {
      "const": "ndf-source-tree-verification-v1"
    },
    "stage": {
      "enum": ["post_cleanup", "runtime_image"]
    },
    "source_provenance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "const": 2
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "status": {
      "const": "passed"
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "entry_count",
        "file_count",
        "directory_count",
        "symlink_count"
      ],
      "properties": {
        "algorithm": {
          "const": "ndf-source-tree-sha256-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "directory_count": {
          "type": "integer",
          "minimum": 0
        },
        "symlink_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "submodule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "materialized",
        "expected_commit",
        "expected_source_tree",
        "observed_source_tree",
        "matches",
        "submodules"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "materialized": {
          "type": "boolean"
        },
        "expected_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "expected_source_tree": {
          "oneOf": [
            {
              "$ref": "#/$defs/fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_source_tree": {
          "oneOf": [
            {
              "$ref": "#/$defs/fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "matches": {
          "const": true
        },
        "submodules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/submodule"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expected_source_tree",
        "observed_source_tree",
        "matches",
        "submodules"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected_source_tree": {
          "$ref": "#/$defs/fingerprint"
        },
        "observed_source_tree": {
          "$ref": "#/$defs/fingerprint"
        },
        "matches": {
          "const": true
        },
        "submodules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/submodule"
          }
        }
      }
    }
  }
}
