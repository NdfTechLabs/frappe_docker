{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ndf:schemas:source-provenance-v1",
  "title": "NDF Pre-cleanup Source Provenance",
  "description": "Git provenance, post-clone source changes and complete source-tree fingerprints captured before Git metadata cleanup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "lock",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithm": {
      "const": "ndf-source-provenance-v1"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "requested_ref",
        "resolver_commit",
        "actual_commit",
        "head_tree",
        "tracked_content",
        "generated_content",
        "source_tree"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/@:]+/.+$"
        },
        "requested_ref": {
          "type": "string",
          "minLength": 1
        },
        "resolver_commit": {
          "type": "string"
        },
        "actual_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "head_tree": {
          "$ref": "#/$defs/gitObject"
        },
        "tracked_content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matches_head",
            "installation_modified_paths",
            "installation_diff_sha256"
          ],
          "properties": {
            "matches_head": {
              "type": "boolean"
            },
            "installation_modified_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "installation_diff_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "generated_content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "untracked_paths",
            "ignored_paths"
          ],
          "properties": {
            "origin": {
              "const": "post_clone_bench_init"
            },
            "untracked_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "ignored_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_tree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "sha256",
            "entry_count",
            "file_count",
            "directory_count",
            "symlink_count"
          ],
          "properties": {
            "algorithm": {
              "const": "ndf-source-tree-sha256-v1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "entry_count": {
              "type": "integer",
              "minimum": 0
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            },
            "directory_count": {
              "type": "integer",
              "minimum": 0
            },
            "symlink_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
