{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ndf:schemas:image-verification-evidence-v1",
  "title": "NDF Image Verification Evidence Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "image",
    "lock",
    "evidence",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithm": {
      "const": "ndf-image-verification-evidence-v1"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "repository",
        "id",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "enum": [
              "lock_v2",
              "apps_json",
              "build_metadata",
              "buildx_metadata",
              "build_inventory",
              "build_evidence",
              "source_provenance",
              "source_provenance_verification",
              "source_tree_post_cleanup",
              "source_tree_runtime",
              "image_composition_verification"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "status": {
      "const": "bound"
    }
  }
}
