{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/cosign-deployment-candidate-origin-statement-v0.1.schema.json",
  "title": "Cosign Deployment Candidate Origin Statement v0.1 Compatibility Profile",
  "description": "Strict Cosign v3.1.4 verified in-toto Statement v0.1 wrapper for the DT Master candidate-origin predicate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v0.1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://ndftechlabs.com/attestations/deployment-candidate/v1"
    },
    "predicate": { "type": "object" }
  }
}
