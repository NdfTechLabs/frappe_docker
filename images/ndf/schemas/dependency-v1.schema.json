{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/dependency-v1.schema.json",
  "title": "NDF Marketplace Dependency Definitions",
  "$defs": {
    "versionConstraint": {
      "type": "string",
      "minLength": 1,
      "description": "A constraint interpreted using the declared ecosystem's version semantics. Frappe/ERPNext and Node use SemVer-compatible ranges; Python uses PEP 440 specifiers; OS packages use the native package manager's version syntax."
    },
    "disposition": {
      "type": "string",
      "enum": [
        "base",
        "runtime_compatible",
        "environment_level"
      ]
    },
    "benchApp": {
      "type": "object",
      "required": [
        "app_id",
        "required"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pythonPackage": {
      "type": "object",
      "required": [
        "name",
        "disposition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "build_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "nodePackage": {
      "type": "object",
      "required": [
        "name",
        "package_manager",
        "scope",
        "disposition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "package_manager": {
          "enum": [
            "npm",
            "yarn",
            "pnpm"
          ]
        },
        "scope": {
          "enum": [
            "build",
            "runtime"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      },
      "additionalProperties": false
    },
    "osPackage": {
      "type": "object",
      "required": [
        "name",
        "distribution_family",
        "package_manager",
        "scope",
        "disposition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "distribution_family": {
          "type": "string",
          "minLength": 1
        },
        "package_manager": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "build",
            "runtime"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      },
      "additionalProperties": false
    }
  }
}
