{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/dependency-v1.schema.json",
  "title": "NDF Marketplace Dependency Definitions",
  "$defs": {
    "versionConstraint": {
      "type": "string",
      "minLength": 1,
      "description": "SemVer 2.0.0 range for Frappe/ERPNext/Node ecosystems; PEP 440 specifier for Python. OS package versions use native package-manager syntax and are not parsed by a generic comparator."
    },
    "disposition": {
      "type": "string",
      "enum": [
        "base",
        "runtime_compatible",
        "environment_level"
      ]
    },
    "benchApp": {
      "type": "object",
      "required": [
        "app_id",
        "required"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "notes": {
          "type": "string"
        },
        "version_policy": {
          "$ref": "#/$defs/versionPolicy"
        }
      },
      "additionalProperties": false
    },
    "pythonPackage": {
      "type": "object",
      "required": [
        "name",
        "disposition",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "build_required": {
          "type": "boolean"
        },
        "version_policy": {
          "$ref": "#/$defs/versionPolicy"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "nodePackage": {
      "type": "object",
      "required": [
        "name",
        "package_manager",
        "scope",
        "disposition",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "package_manager": {
          "enum": [
            "npm",
            "yarn",
            "pnpm"
          ]
        },
        "scope": {
          "enum": [
            "build",
            "runtime"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "version_policy": {
          "$ref": "#/$defs/versionPolicy"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "osPackage": {
      "type": "object",
      "required": [
        "name",
        "distribution_family",
        "package_manager",
        "scope",
        "disposition",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionConstraint"
        },
        "distribution_family": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "debian",
            "rpm",
            "alpine"
          ]
        },
        "package_manager": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "apt",
            "dpkg",
            "dnf",
            "yum",
            "rpm",
            "apk"
          ]
        },
        "scope": {
          "enum": [
            "build",
            "runtime"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "version_policy": {
          "$ref": "#/$defs/versionPolicy"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "versionPolicy": {
      "type": "string",
      "enum": [
        "constraint",
        "latest_compatible"
      ],
      "description": "Explicit version selection policy. Omission is allowed during authoring but blocks production eligibility."
    }
  }
}
