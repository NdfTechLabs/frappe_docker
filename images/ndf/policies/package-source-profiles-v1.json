{
  "catalogue_version": "1.1.0",
  "description": "NDF-governed package source profiles and native resolver policy for M4.2.3. Descriptors may select approved profile identifiers only; they cannot define registry URLs, credentials, resolver commands or executable policy.",
  "source_profiles": {
    "python-pypi-public-v1": {
      "ecosystem": "python",
      "enabled": true,
      "registry": "https://pypi.org/simple",
      "artifact_hosts": [
        "files.pythonhosted.org"
      ],
      "transport": "https",
      "credentials": "none",
      "redirect_policy": "same-origin-or-explicit-artifact-host-only",
      "repository_snapshot": "not-provided-by-profile",
      "integrity": "record-and-verify-artifact-hashes-when-published",
      "source_identity": "official-public-pypi"
    },
    "node-npm-public-v1": {
      "ecosystem": "node",
      "enabled": true,
      "registry": "https://registry.npmjs.org",
      "artifact_hosts": [
        "registry.npmjs.org"
      ],
      "transport": "https",
      "credentials": "none",
      "redirect_policy": "same-origin-only",
      "repository_snapshot": "not-provided-by-profile",
      "integrity": "record-and-verify-package-dist-integrity-when-published",
      "source_identity": "official-public-npm-registry"
    },
    "os-debian-trixie-public-amd64-v1": {
      "ecosystem": "os",
      "distribution": "debian",
      "release": "13",
      "codename": "trixie",
      "architecture": "amd64",
      "enabled": true,
      "repositories": [
        {
          "uri": "http://deb.debian.org/debian",
          "suites": [
            "trixie",
            "trixie-updates"
          ],
          "components": [
            "main"
          ]
        },
        {
          "uri": "http://deb.debian.org/debian-security",
          "suites": [
            "trixie-security"
          ],
          "components": [
            "main"
          ]
        }
      ],
      "package_manager": "apt",
      "package_database": "dpkg",
      "credentials": "none",
      "trust": "require-valid-debian-archive-signatures-and-apt-authenticated-release-metadata",
      "repository_snapshot": "not-provided-by-profile",
      "repository_identity": "record-authenticated-inrelease-or-release-metadata-identity-and-hash",
      "architecture_scope": "amd64-only-until-arm64-target-validation"
    }
  },
  "resolver_policy": {
    "python": {
      "preferred": "uv",
      "fallback": {
        "name": "pip",
        "enabled_only_after": "equivalent-target-resolution-and-integrity-tests-pass"
      },
      "version": "0.13.7",
      "version_rule": "exact-version-required-and-recorded-in-every-package-lock-record",
      "upgrade_policy": "explicit-reviewed-policy-change-with-catalogue-version-increment-and-regression-acceptance"
    },
    "node": {
      "name": "npm",
      "version_rule": "use-and-record-exact-npm-version-from-the-selected-target-runtime"
    },
    "os": {
      "resolver": "apt",
      "inventory_and_version_semantics": "dpkg",
      "version_rule": "use-and-record-exact-apt-and-dpkg-versions-from-the-disposable-target-environment"
    },
    "unsupported": [
      "yarn",
      "pnpm",
      "dnf",
      "yum",
      "apk"
    ]
  },
  "global_rules": {
    "profile_selection": "identifier-only",
    "publisher_supplied_registry_urls": "rejected",
    "descriptor_source_hints": "hints-only-and-must-match-an-enabled-ndf-profile",
    "credential_bearing_urls": "rejected",
    "credentials_in_descriptors_locks_logs_or_errors": "prohibited",
    "unapproved_redirects_or_source_substitutions": "rejected",
    "mutable_upstream_metadata": "record-exact-selected-versions-source-identity-and-integrity-metadata-where-available;-do-not-claim-immutable-snapshot-reproducibility",
    "unsupported_profiles_or_incomplete_trust_metadata": "fail-closed"
  }
}
